{
  "git.enabled": false,
  "git.autoRepositoryDetection": false,
  "scm.alwaysShowRepositories": false,
  "workbench.startupEditor": "none",
  "editor.minimap.enabled": false,
  "explorer.compactFolders": false,
  "breadcrumbs.enabled": true,
  "files.exclude": {
    "**/.git": true,
    "**/node_modules": true,
    "**/dist": true,
    "**/build": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/build": true
  }
}
