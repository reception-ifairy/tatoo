# Ötzi Signal. AI keys are best added in the app: Settings → API keys (stored encrypted, tested, model list).
# The variables below are optional fallbacks.
# ANTHROPIC_API_KEY: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=""
# OPENAI_API_KEY: platform.openai.com → API keys
# OPENAI_API_KEY=""
# GEMINI_API_KEY: aistudio.google.com → Get API key (also voice, and the default image model)
# GEMINI_API_KEY=""
# REPLICATE_API_TOKEN: replicate.com → Account settings → API tokens (FLUX models)
# REPLICATE_API_TOKEN=""
# STABILITY_API_KEY: platform.stability.ai → Account → API keys (Stable Image, SD3.5)
# STABILITY_API_KEY=""

# ANTHROPIC_MODEL (optional): default Claude model before another is chosen in Settings.
# ANTHROPIC_MODEL="claude-opus-5-5"

# DB_HOST / DB_PORT / DB_USER / DB_PASSWORD / DB_NAME (optional): MariaDB/MySQL for keys, settings, accounts, projects and conversations.
# Without them everything goes to data/otzi-settings.json (local install). Pictures and scar photos are always files in data/projects/.
# Tables are prefixed with APP.id ('otzi'), so several apps can share one database.
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=app
# DB_PASSWORD=""
# DB_NAME=app

# *_BASE_URL (tests only): ANTHROPIC_BASE_URL, OPENAI_BASE_URL, GEMINI_BASE_URL, REPLICATE_BASE_URL, STABILITY_BASE_URL
# point requests at a local mock instead of the real providers.

# SETTINGS_SECRET (recommended on a server): 64 hex chars (openssl rand -hex 32), encrypts stored API keys.
# Without it the key is derived from SESSION_SECRET. Changing it invalidates stored keys.
# SETTINGS_SECRET=""

# PORT (optional): server port, default 3000.
# PORT=3000

# HOST (optional): default 127.0.0.1 (this computer only). 0.0.0.0 exposes the app on the network.
# HOST=127.0.0.1

# OWNER_LOGIN / OWNER_PASSWORD: the super admin's login. Clients get their accounts from the admin in the app.
# With an empty OWNER_PASSWORD the admin cannot sign in (start.ps1 asks for both on the first run).
OWNER_LOGIN=""
OWNER_PASSWORD=""

# SESSION_SECRET: random string that signs the session cookie (start.ps1 generates it).
# Without it everyone has to sign in again after each server restart.
SESSION_SECRET=""
