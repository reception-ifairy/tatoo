# OpenAI — klucz pozostaje wyłącznie po stronie serwera.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# MariaDB / MySQL. DATABASE_URL ma pierwszeństwo przed polami poniżej.
# DATABASE_URL=mysql://user:password@127.0.0.1:3306/t1000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=t1000

# Lokalnie można użyć unix socket zamiast DB_HOST.
DB_SOCKET=/run/mysqld/mysqld.sock
