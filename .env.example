# OpenAI — keep the key server-side only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# MariaDB / MySQL. DATABASE_URL takes precedence over the fields below.
# DATABASE_URL=mysql://user:password@127.0.0.1:3306/t1000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=t1000

# Locally, a Unix socket can be used instead of DB_HOST.
DB_SOCKET=/run/mysqld/mysqld.sock

# Private owner access. Never reuse database or operating-system credentials.
OWNER_LOGIN=owner
OWNER_PASSWORD=replace-with-a-long-random-password
AUTH_SECRET=replace-with-at-least-32-random-bytes
